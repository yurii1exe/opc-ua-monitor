{
  "Opc": {
    "EndpointUrl": "opc.tcp://localhost:62541",
    "ApplicationUri": "urn:localhost:OpcMonitor:Probe",
    "ApplicationName": "OpcMonitorProbe",
    "CertificateSubjectName": "CN=OpcMonitorProbe, O=OpcMonitor, C=US",
    "PkiRoot": "pki",
    "UseSecurity": true,
    "AllowNoSecurityFallback": true,
    "AcceptUntrustedServerCertificate": true,
    "PreserveRequestedEndpointUrl": true,
    "Nodes": [
      { "Address": "Server/ServerStatus/CurrentTime", "DisplayName": "Server time" },
      { "Address": "Server/ServerStatus/State", "DisplayName": "Server state" },
      { "Address": "Server/ServerStatus/StartTime", "DisplayName": "Server start time" }
    ]
  }
}
