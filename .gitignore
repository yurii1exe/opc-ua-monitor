# Working notes — must never be committed
BUILD-PLAN.md

# OPC UA application instance PKI.
# Generated on first run. Never committed: certificates embed the machine
# hostname in their subject alternative names.
pki/
**/pki/

# Local-only configuration overrides.
# Deliberately narrow: a broad "*.local.json" also matches the committed
# appsettings.Local.json profile on case-insensitive filesystems, which silently
# leaves that profile out of the repository.
appsettings.*.local.json
appsettings.local.overrides.json

